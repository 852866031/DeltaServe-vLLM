<mxfile host="deltaserve"><diagram name="overview" id="overview"><mxGraphModel adaptiveColors="auto" grid="1" gridSize="10" page="0" pageWidth="1350" pageHeight="424"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="DeltaServe in one picture: inference and LoRA finetuning share the GPU" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="16" width="1350" height="40" as="geometry"/></mxCell><mxCell id="req" value="&lt;b&gt;Inference requests&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot; color=&quot;#444c56&quot;&gt;OpenAI-compatible API&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=16;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#1f2328;" vertex="1" parent="1"><mxGeometry x="30" y="80" width="240" height="84" as="geometry"/></mxCell><mxCell id="data" value="&lt;b&gt;Finetuning dataset&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot; color=&quot;#444c56&quot;&gt;SFT samples&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=16;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1f2328;" vertex="1" parent="1"><mxGeometry x="30" y="250" width="240" height="84" as="geometry"/></mxCell><mxCell id="sched" value="&lt;b&gt;SLO-aware scheduler&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot; color=&quot;#444c56&quot;&gt;admits FT samples only while&lt;br&gt;TTFT / TBT stay within the SLO&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1f2328;" vertex="1" parent="1"><mxGeometry x="380" y="80" width="240" height="84" as="geometry"/></mxCell><mxCell id="fwd" value="&lt;b&gt;vLLM forward, one batch&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot; color=&quot;#444c56&quot;&gt;inference tokens + FT samples&lt;br&gt;multi-LoRA · CUDA graphs&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1