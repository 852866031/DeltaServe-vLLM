<mxCell id="d1" value="&lt;b&gt;Indexing: GPU or CPU&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;GPU only if no inference&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="480" y="390" width="190" height="80" as="geometry"/></mxCell><mxCell id="d2" value="&lt;b&gt;Start handover&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;when a job ends&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="700" y="390" width="190" height="80" as="geometry"/></mxCell><mxCell id="x1" value="&lt;b&gt;④ Indexing&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;runs in its own process&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="480" y="560" width="190" height="80" as="geometry"/></mxCell><mxCell id="x2" value="&lt;b&gt;⑤ Adapter handover&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;off the engine loop&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="700" y="560" width="190" height="80" as="geometry"/></mxCell>

