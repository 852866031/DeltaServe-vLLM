<mxfile host="app.diagrams.net"><diagram name="indexing" id="06-indexing"><mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/>

<mxCell id="ds" value="&lt;b&gt;Finetuning dataset&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;up to 2500 samples&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="115" width="190" height="65" as="geometry"/></mxCell>
<mxCell id="ad" value="&lt;b&gt;New adapter&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;no routing entry yet&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="190" height="65" as="geometry"/></mxCell>
<mxCell id="ix" value="&lt;b&gt;④ Indexing&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;takes the next chunk&lt;br&gt;of samples&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="290" y="110" width="200" height="150" as="geometry"/></mxCell>
<mxCell id="dec" value="inference request present?" style="rhombus;whiteSpace=wrap;html=1;fontSize=14;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="540" y="135" width="190" height="100" as="geometry"/></mxCell>
<mxCell id="gpu" value="&lt;b&gt;Encode on the GPU&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;own process, shares the&lt;br&gt;encoder weights&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="800" y="40" width="250" height="100" as="geometry"/></mxCell>
<mxCell id="cpu" value="&lt;b&gt;Encode on the CPU&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;lowest priority,&lt;br&gt;2–8 threads&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="800" y="230" width="250" height="100" as="geometry"/></mxCell>
<mxCell id="sum" value="&lt;b&gt;Running sum&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;checkpointed after every chunk&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1120" y="135" width="200" height="100" as="geometry"/></mxCell>
<mxCell id="pool" value="&lt;b&gt;Adapter pool&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;routing entry =&lt;br&gt;the samples' centroid&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1400" y="135" width="200" height="100" as="geometry"/></mxCell>
