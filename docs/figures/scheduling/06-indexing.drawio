<mxCell id="e6" value="request arrives: stops within 1 ms" style="html=1;strokeColor=#4A5568;strokeWidth=2;fontSize=13;fontColor=#4A5568;endArrow=block;dashed=1;" edge="1" parent="1" source="gpu" target="cpu"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
