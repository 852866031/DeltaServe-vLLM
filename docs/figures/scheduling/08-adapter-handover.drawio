<mxfile host="app.diagrams.net"><diagram name="adapter-handover" id="08-adapter-handover"><mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/>

<mxCell id="zone" value="⑤ Adapter handover — off the engine loop" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=14;fontColor=#4A5568;fillColor=#FFF8EE;strokeColor=#D79B00;dashed=1;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="570" y="60" width="560" height="170" as="geometry"/></mxCell>
<mxCell id="job" value="&lt;b&gt;Finetuning job&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;training finished&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="200" height="100" as="geometry"/></mxCell>
<mxCell id="sch" value="&lt;b&gt;SLO-aware scheduler&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;closes FT admission&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="310" y="100" width="200" height="100" as="geometry"/></mxCell>
<mxCell id="h1" value="&lt;b&gt;Backward process&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;copies the weights&lt;br&gt;to host memory&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="590" y="100" width="250" height="100" as="geometry"/></mxCell>
<mxCell id="h2" value="&lt;b&gt;Engine background thread&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;merge · save · publish&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="860" y="100" width="250" height="100" as="geometry"/></mxCell>
<mxCell id="pool" value="&lt;b&gt;Adapter pool&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;the new adapter&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1210" y="100" width="200" height="100" as="geometry"/></mxCell>
<mxCell id="nxt" value="&lt;b&gt;③ Backward batch&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;switches to the next job's adapter&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="590" y="320" width="250" height="90" as="geometry"/></mxCell>
<mxCell id="idx" value="&lt;b&gt;④ Indexing&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;routing entry, built&lt;br&gt;while the job trained&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1210" y="320" width="200" height="90" as="geometry"/></mxCell>
<mxCell id="e1" value="done" style="html=1;strokeColor=#4A5568;strokeWidth=2;fontSize=13;fontColor=#4A5568;endArrow=block;" edge="1" parent="1" source="job" target="sch"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e2" value="start" style="html=1;strokeColor=#4A5568;strokeWidth=2;fontSize=13;fontColor=#4A5568;endArrow=block;" edge="1" parent="1" source="sch" target="h1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e3" value="" style="html=1;strokeColor=#4A5568;strokeWidth=2;fontSize=13;fontColor=#4A5568;endArrow=block;" edge="1" parent="1" source="h1" target="h2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e4" value="publish" style="html=1;strokeColor=#4A5568;strokeWidth=2;fontSize=13;fontColor=#4A5568;endArrow=block;" edge="1" parent="1" source="h2" target="pool"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e5" value="weights copied" style="html=1;strokeColor=#4A5568;strokeWidth=2;fontSize=13;fontColor=#4A5568;endArrow=block;" edge="1" parent="1" source="h1" target="nxt"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e6" value="routing entry" style="html=1;strokeColor=#4A5568;strokeWidth=2;fontSize=13;fontColor=#4A5568;endArrow=block;" edge="1" parent="1" source="idx" target="pool"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e7" value="FT admission reopens" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4A5568;strokeWidth=2;fontSize=13;fontColor=#4A5568;endArrow=block;dashed=1;exitX=0;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="nxt" target="sch"><mxGeometry x="-0.2" relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="note" value="Saving is not time-critical: nothing here runs on the engine loop or keeps the GPU from inference." style="text;html=1;whiteSpace=wrap;fontSize=13;align=left;verticalAlign=middle;fontColor=#4A5568;" vertex="1" parent="1"><mxGeometry x="860" y="330" width="330" height="70" as="geometry"/></mxCell>
