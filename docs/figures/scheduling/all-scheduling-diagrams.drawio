<diagram name="deltaserve-overview" id="02-deltaserve-overview"><mxGraphModel adaptiveColors="auto" grid="1" gridSize="10" page="0" pageWidth="1350" pageHeight="424"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="req" value="&lt;b&gt;Inference requests&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot; color=&quot;#444c56&quot;&gt;OpenAI-compatible API&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=16;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#1f2328;" vertex="1" parent="1"><mxGeometry x="30" y="80" width="240" height="84" as="geometry"/></mxCell><mxCell id="data" value="&lt;b&gt;Finetuning dataset&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot; color=&quot;#444c56&quot;&gt;SFT samples&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=16;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1f2328;" vertex="1" parent="1"><mxGeometry x="30" y="250" width="240" height="84" as="geometry"/></mxCell><mxCell id="sched" value="&lt;b&gt;SLO-aware scheduler&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot; color=&quot;#444c56&quot;&gt;admits FT samples only while&lt;br&gt;TTFT / TBT stay within the SLO&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1f2328;" vertex="1" parent="1"><mxGeometry x="380" y="80" width="240" height="84" as="geometry"/></mxCell><mxCell id="fwd" value="&lt;b&gt;vLLM forward, one batch&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot; color=&quot;#444c56&quot;&gt;inference tokens + FT samples&lt;br&gt;multi-LoRA · CUDA graphs&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=16;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#1f2328;" vertex="1" parent="1"><mxGeometry x="730" y="80" width="240" height="84" as="geometry"/></mxCell><mxCell id="resp" value="&lt;b&gt;Responses&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot; color=&quot;#444c56&quot;&gt;unchanged by co-serving&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=16;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#1f2328;" vertex="1" parent="1"><mxGeometry x="1080" y="80" width="240" height="84" as="geometry"/></mxCell><mxCell id="act" value="&lt;b&gt;Saved FT activations&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot; color=&quot;#444c56&quot;&gt;shared GPU buffers&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=16;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1f2328;" vertex="1" parent="1"><mxGeometry x="1080" y="250" width="240" height="84" as="geometry"/></mxCell><mxCell id="bwd" value="&lt;b&gt;Backward process&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot; color=&quot;#444c56&quot;&gt;trains the LoRA adapter;&lt;br&gt;pauses whenever inference&lt;br&gt;needs the GPU&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1f2328;" vertex="1" parent="1"><mxGeometry x="730" y="250" width="240" height="84" as="geometry"/></mxCell><mxCell id="e0" value="requests" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=13;strokeColor=#4d5866;fontColor=#4d5866;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=default;defaultLabelBackgroundColor=page;" edge="1" parent="1" source="req" target="sched"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="FT samples" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=13;strokeColor=#4d5866;fontColor=#4d5866;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;labelBackgroundColor=default;defaultLabelBackgroundColor=page;" edge="1" parent="1" source="data" target="sched"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="mixed batch" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=13;strokeColor=#4d5866;fontColor=#4d5866;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=default;defaultLabelBackgroundColor=page;" edge="1" parent="1" source="sched" target="fwd"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="tokens" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=13;strokeColor=#4d5866;fontColor=#4d5866;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=default;defaultLabelBackgroundColor=page;" edge="1" parent="1" source="fwd" target="resp"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="FT rows" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=13;strokeColor=#4d5866;fontColor=#4d5866;strokeWidth=1.5;exitX=0.8;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=default;defaultLabelBackgroundColor=page;dashed=1;dashPattern=5 3;" edge="1" parent="1" source="fwd" target="act"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="read" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=13;strokeColor=#4d5866;fontColor=#4d5866;strokeWidth=1.5;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=default;defaultLabelBackgroundColor=page;dashed=1;dashPattern=5 3;" edge="1" parent="1" source="act" target="bwd"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="updated LoRA" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=13;strokeColor=#4d5866;fontColor=#4d5866;strokeWidth=1.5;exitX=0.3;exitY=0;exitDx=0;exitDy=0;entryX=0.3;entryY=1;entryDx=0;entryDy=0;labelBackgroundColor=default;defaultLabelBackgroundColor=page;" edge="1" parent="1" source="bwd" target="fwd"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram>
