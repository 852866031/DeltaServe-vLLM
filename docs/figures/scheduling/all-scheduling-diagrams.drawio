<mxCell id="f1" value="&lt;b&gt;On the GPU&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;4–17 ms ✓&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#F4F4F4;strokeColor=#666666;strokeWidth=2;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="55" y="340" width="160" height="75" as="geometry"/></mxCell>
<mxCell id="f2" value="&lt;b&gt;On the CPU&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;50–130 ms:&lt;br&gt;too slow for TTFT ✗&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="225" y="340" width="200" height="75" as="geometry"/></mxCell>
<mxCell id="f3" value="&lt;b&gt;Encoder size&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;≈ 1.3 GiB, one GPU&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#F4F4F4;strokeColor=#666666;strokeWidth=2;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="435" y="340" width="150" height="75" as="geometry"/></mxCell>
<mxCell id="how" value="Confidence = how close the best entry is, plus how far ahead of the second. Below the pool's threshold, the base model serves the request." style="text;html=1;whiteSpace=wrap;fontSize=13;align=left;verticalAlign=middle;fontColor=#4A5568;" vertex="1" parent="1"><mxGeometry x="1000" y="320" width="300" height="90" as="geometry"/></mxCell>
