<mxCell id="w2" value="&lt;b&gt;Worker, rank N−1&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;model shard · KV · LoRA slots&lt;br&gt;&lt;b&gt;+ e5 encoder (① Encoding)&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#F4F4F4;strokeColor=#666666;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="765" y="370" width="270" height="90" as="geometry"/></mxCell>
<mxCell id="b2" value="&lt;b&gt;③ Backward process&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;rank N−1&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="765" y="535" width="270" height="85" as="geometry"/></mxCell>
