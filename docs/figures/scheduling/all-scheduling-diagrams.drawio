<diagram name="one-scheduling-step" id="11-one-scheduling-step"><mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/>

<mxCell id="zone" value="scheduler, in this order" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=14;fontColor=#4A5568;fillColor=#F6F9FF;strokeColor=#6C8EBF;dashed=1;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="25" y="225" width="1110" height="270" as="geometry"/></mxCell>
<mxCell id="i1" value="&lt;b&gt;Routed requests&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;no adapter yet&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fillColor=#F4F4F4;strokeColor=#666666;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="190" height="80" as="geometry"/></mxCell>
<mxCell id="i2" value="&lt;b&gt;Adapter pool&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="260" y="80" width="190" height="80" as="geometry"/></mxCell>
<mxCell id="i3" value="&lt;b&gt;Waiting + running&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;requests&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fillColor=#F4F4F4;strokeColor=#666666;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="480" y="80" width="190" height="80" as="geometry"/></mxCell>
<mxCell id="i4" value="&lt;b&gt;FT samples&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;+ TTFT / TBT deadlines&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="700" y="80" width="190" height="80" as="geometry"/></mxCell>
<mxCell id="i5" value="&lt;b&gt;FT activation buffer&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="920" y="80" width="190" height="80" as="geometry"/></mxCell>
<mxCell id="s1" value="&lt;b&gt;1 Encode&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;run ① and wait&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="265" width="190" height="90" as="geometry"/></mxCell>
<mxCell id="s2" value="&lt;b&gt;2 Attach adapter&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;hold cold ones one step&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="260" y="265" width="190" height="90" as="geometry"/></mxCell>
<mxCell id="s3" value="&lt;b&gt;3 Fill the batch&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;decode, then prefill&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fillColor=#F4F4F4;strokeColor=#666666;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="480" y="265" width="190" height="90" as="geometry"/></mxCell>
<mxCell id="s4" value="&lt;b&gt;4 Admit FT&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;only into the SLO slack&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="700" y="265" width="190" height="90" as="geometry"/></mxCell>
<mxCell id="s5" value="&lt;b&gt;5 Trigger backward&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;when the buffer is full&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="920" y="265" width="190" height="90" as="geometry"/></mxCell>
<mxCell id="out" value="&lt;b&gt;② Forward engine batch&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;sent to the workers&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=15;fillColor=#F4F4F4;strokeColor=#666666;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1170" y="265" width="190" height="90" as="geometry"/></mxCell>
