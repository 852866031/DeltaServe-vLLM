<mxCell id="g" value="&lt;b&gt;GPU slots&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;usable in a batch now&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="960" y="310" width="240" height="90" as="geometry"/></mxCell>
