<mxCell id="fwd" value="&lt;b&gt;② Forward engine batch&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;inference tokens + FT samples&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#F4F4F4;strokeColor=#666666;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="760" y="110" width="260" height="100" as="geometry"/></mxCell>
