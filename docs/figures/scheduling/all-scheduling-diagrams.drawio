<mxCell id="o2" value="&lt;b&gt;Base model&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;no confident match&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#F4F4F4;strokeColor=#666666;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1070" y="155" width="230" height="60" as="geometry"/></mxCell>
