<mxfile host="app.diagrams.net"><diagram name="encoding" id="05-encoding"><mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/>

<mxCell id="req" value="&lt;b&gt;Routed request&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;encoder token ids, up to 512&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#F4F4F4;strokeColor=#666666;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="230" height="100" as="geometry"/></mxCell>
<mxCell id="enc" value="&lt;b&gt;① Encoding&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;e5-large-v2, on the GPU,&lt;br&gt;inside one worker&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="350" y="100" width="250" height="100" as="geometry"/></mxCell>
<mxCell id="pick" value="&lt;b&gt;Pick adapter&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;closest routing entry,&lt;br&gt;if confident enough&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="700" y="80" width="250" height="140" as="geometry"/></mxCell>
<mxCell id="o1" value="&lt;b&gt;Adapter&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;request is served with it&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#F4F4F4;strokeColor=#666666;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1070" y="85" width="230" height="60" as="geometry"/></mxCell>
<mxCell id="o2" value="&lt;b&gt;Base model&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;no confident match&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#F4F4F4;strokeColor=#666666;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1070" y="155" width="230" height="60" as="geometry"/></mxCell>
<mxCell id="pool" value="&lt;b&gt;Adapter pool&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;one routing entry per adapter&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="700" y="320" width="250" height="90" as="geometry"/></mxCell>
<mxCell id="cost" value="what the encoder costs" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=14;fontColor=#4A5568;fillColor=#FAFAFA;strokeColor=#999999;dashed=1;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="560" height="130" as="geometry"/></mxCell>
<mxCell id="f1" value="&lt;b&gt;On the GPU&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;4–17 ms&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#F4F4F4;strokeColor=#666666;strokeWidth=2;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="55" y="340" width="160" height="75" as="geometry"/></mxCell>
<mxCell id="f2" value="&lt;b&gt;On the CPU&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;50–130 ms:&lt;br&gt;too slow for TTFT&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#F4F4F4;strokeColor=#666666;strokeWidth=2;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="225" y="340" width="200" height="75" as="geometry"/></mxCell>
<mxCell id="f3" value="&lt;b&gt;Encoder size&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;≈ 1.3 GiB, one GPU&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#F4F4F4;strokeColor=#666666;strokeWidth=2;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="435" y="340" width="150" height="75" as="geometry"/></mxCell>
<mxCell id="how" value="Confidence = how close the best entry is, plus how far ahead of the second. Below the pool's threshold, the base model serves the request." style="text;html=1;whiteSpace=wrap;fontSize=13;align=left;verticalAlign=middle;fontColor=#4A5568;" vertex="1" parent="1"><mxGeometry x="1000" y="320" width="300" height="90" as="geometry"/></mxCell>
<mxCell id="e1" value="token ids" style="html=1;strokeColor=#4A5568;strokeWidth=2;fontSize=13;fontColor=#4A5568;endArrow=block;" edge="1" parent="1" source="req" target="enc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e2" value="embedding" style="html=1;strokeColor=#4A5568;strokeWidth=2;fontSize=13;fontColor=#4A5568;endArrow=block;" edge="1" parent="1" source="enc" target="pick"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e3" value="confident" style="html=1;strokeColor=#4A5568;strokeWidth=2;fontSize=13;fontColor=#4A5568;endArrow=block;exitX=1;exitY=0.25;entryX=0;entryY=0.5;" edge="1" parent="1" source="pick" target="o1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e4" value="not confident" style="html=1;strokeColor=#4A5568;strokeWidth=2;fontSize=13;fontColor=#4A5568;endArrow=block;exitX=1;exitY=0.75;entryX=0;entryY=0.5;" edge="1" parent="1" source="pick" target="o2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e5" value="routing entries" style="html=1;strokeColor=#4A5568;strokeWidth=2;fontSize=13;fontColor=#4A5568;endArrow=block;" edge="1" parent="1" source="pool" target="pick"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e6" value="" style="html=1;strokeColor=#4A5568;strokeWidth=2;fontSize=13;fontColor=#4A5568;endArrow=block;dashed=1;endArrow=none;exitX=0.5;exitY=1;entryX=0.7768;entryY=0;" edge="1" parent="1" source="enc" target="cost"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
