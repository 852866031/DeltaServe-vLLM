<mxfile host="app.diagrams.net"><diagram name="schedulable-objects" id="09-schedulable-objects"><mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/>

<mxCell id="sch" value="&lt;b&gt;SLO-aware scheduler&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="1250" height="60" as="geometry"/></mxCell>
<mxCell id="g1" value="issued every step" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=14;fontColor=#4A5568;fillColor=#F6F9FF;strokeColor=#6C8EBF;dashed=1;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="25" y="225" width="510" height="180" as="geometry"/></mxCell>
<mxCell id="g2" value="background: runs on its own, gated by the scheduler" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fontSize=14;fontColor=#4A5568;fillColor=#F6F9FF;strokeColor=#6C8EBF;dashed=1;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="545" y="225" width="760" height="180" as="geometry"/></mxCell>
<mxCell id="o1" value="&lt;b&gt;① Encoding&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;worker · 4–17 ms&lt;br&gt;before the batch&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="270" width="230" height="110" as="geometry"/></mxCell>
<mxCell id="o2" value="&lt;b&gt;② Forward engine batch&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;all workers&lt;br&gt;prefill + decode + FT samples&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#F4F4F4;strokeColor=#666666;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="290" y="270" width="230" height="110" as="geometry"/></mxCell>
<mxCell id="o3" value="&lt;b&gt;③ Backward batch&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;backward process&lt;br&gt;yields to ① and prefill&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="560" y="270" width="230" height="110" as="geometry"/></mxCell>
<mxCell id="o4" value="&lt;b&gt;④ Indexing&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;own process&lt;br&gt;GPU if no inference, else CPU&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="810" y="270" width="230" height="110" as="geometry"/></mxCell>
<mxCell id="o5" value="&lt;b&gt;⑤ Adapter handover&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;background threads&lt;br&gt;save · publish · next job&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1060" y="270" width="230" height="110" as="geometry"/></mxCell>
<mxCell id="e1" value="every step" style="html=1;strokeColor=#4A5568;strokeWidth=2;fontSize=13;fontColor=#4A5568;endArrow=block;exitX=0.092;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="sch" target="o1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e2" value="every step" style="html=1;strokeColor=#4A5568;strokeWidth=2;fontSize=13;fontColor=#4A5568;endArrow=block;exitX=0.292;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="sch" target="o2"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e3" value="buffer full" style="html=1;strokeColor=#4A5568;strokeWidth=2;fontSize=13;fontColor=#4A5568;endArrow=block;dashed=1;exitX=0.508;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="sch" target="o3"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e4" value="load changes" style="html=1;strokeColor=#4A5568;strokeWidth=2;fontSize=13;fontColor=#4A5568;endArrow=block;dashed=1;exitX=0.708;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="sch" target="o4"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e5" value="job finished" style="html=1;strokeColor=#4A5568;strokeWidth=2;fontSize=13;fontColor=#4A5568;endArrow=block;dashed=1;exitX=0.908;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="sch" target="o5"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="prio" value="higher priority  ◀────────────────────────────────────────────────────▶  lower priority" style="text;html=1;fontSize=14;align=center;fontColor=#4A5568;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="1250" height="30" as="geometry"/></mxCell>
<mxCell id="lg" value="solid arrow: issued by the scheduler every step　　dashed arrow: a trigger sent only when something changes" style="text;html=1;fontSize=14;align=left;fontColor=#4A5568;" vertex="1" parent="1"><mxGeometry x="40" y="460" width="1250" height="30" as="geometry"/></mxCell>
<mxCell id="lgo" value="" style="rounded=1;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="505" width="40" height="24" as="geometry"/></mxCell><mxCell id="lgot" value="new with adapter routing" style="text;html=1;fontSize=14;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="90" y="502" width="190" height="30" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>
